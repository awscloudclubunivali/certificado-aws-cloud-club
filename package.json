{
  "name": "certificado-cloud-club",
  "version": "2.0.0",
  "private": true,
  "description": "Gerador de certificados em PDF para o AWS Cloud Club — suporta participantes e organizadores",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awscloudclubunivali/certificado-aws-cloud-club.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test scripts/*.test.js",
    "generate:participantes": "cross-env MODE=participante node scripts/index.js",
    "generate:organizadores": "cross-env MODE=organizador node scripts/index.js",
    "generate:all": "npm run generate:participantes && npm run generate:organizadores"
  },
  "dependencies": {
    "csv-parser": "^3.2.0",
    "dotenv": "^17.4.2",
    "nodemailer": "^10.0.12",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.8.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
